  "source": [
    "# Review the supplied filtered input, rather than rebuilding the queue from all old games.\n",
    "UNMAPPED_GAMES_CSV = ROOT / 'unmapped_bragg_games.csv'\n",
    "required_columns = {'old_aggregator_game_code', 'old_game_name', 'old_game_provider_name', 'old_bets', 'old_rounds'}\n",
    "review_queue = pd.read_csv(UNMAPPED_GAMES_CSV, dtype=str).fillna('')\n",
    "missing_columns = required_columns - set(review_queue.columns)\n",
    "if missing_columns:\n",
    "    raise ValueError(f'{UNMAPPED_GAMES_CSV.name} is missing columns: {sorted(missing_columns)}')\n",
    "\n",
    "for column in ['old_bets', 'old_wins', 'old_rounds']:\n",
    "    if column in review_queue:\n",
    "        review_queue[column] = pd.to_numeric(review_queue[column], errors='coerce').fillna(0)\n",
    "\n",
    "review_queue['_provider_key'] = review_queue['old_game_provider_name'].map(provider_key)\n",
    "review_queue = (\n",
    "    review_queue\n",
    "    .drop_duplicates(subset=['old_aggregator_game_code', 'old_game_name', 'old_game_provider_name'])\n",
    "    .sort_values(['old_bets', 'old_rounds'], ascending=[False, False])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "print(f'Review queue: {len(review_queue):,} games · €{review_queue.old_bets.sum():,.2f} old bets')\n",
    "full_review_queue = review_queue.copy()\n",
    "\n",
    "DECISIONS_CSV = ROOT / 'iterative_mapping_decisions.csv'\n",
    "AUTO_ACCEPTED_CSV = ROOT / 'fuzzy_game_mapping_auto_accepted.csv'\n",
    "BOOKMARK_JSON = ROOT / 'iterative_mapping_bookmark.json'\n",
    "if DECISIONS_CSV.exists():\n",
    "    saved_decisions = pd.read_csv(DECISIONS_CSV, dtype=str).fillna('')\n",
    "    decisions = {row['old_aggregator_game_code']: row.to_dict() for _, row in saved_decisions.iterrows()}\n",
    "else:\n",
    "    decisions = {}\n",
    "# Approved auto matches stay in their own audit file, but must not reappear in the primary manual queue.\n",
    "if AUTO_ACCEPTED_CSV.exists():\n",
    "    approved_auto = pd.read_csv(AUTO_ACCEPTED_CSV, dtype=str).fillna('')\n",
    "    approved_auto_codes = set(approved_auto['old_aggregator_game_code'].str.strip())\n",
    "else:\n",
    "    approved_auto_codes = set()\n",
    "print(f'Restored {len(decisions):,} saved decisions and {len(approved_auto_codes):,} approved auto matches.')\n",
    "# A truly empty same-provider scope means Titan has no products for that provider at all.\n",
    "# Put those records straight into cross-provider review; do not auto-defer weak/generic candidates.\n",
    "titan_provider_catalogue = set(titan['_provider_key'])\n",
    "auto_cross_provider_codes = set(full_review_queue.loc[\n",
    "    ~full_review_queue['_provider_key'].isin(titan_provider_catalogue),\n",
    "    'old_aggregator_game_code',\n",
    "])\n",
    "print(f'Auto-routed {len(auto_cross_provider_codes):,} games with no same-provider Titan catalogue to cross-provider follow-up.')\n",
    "\n",
    "def save_decisions():\n",
    "    result = pd.DataFrame(decisions.values())\n",
    "    result.to_csv(DECISIONS_CSV, index=False)\n",
    "    return result\n",
    "\n",
    "def queue_for_pass(pass_name):\n",
    "    \"\"\"Return an ordered review queue for the selected review pass.\"\"\"\n",
    "    status_by_code = {code: decision.get('status', '') for code, decision in decisions.items()}\n",
    "    if pass_name == 'primary':\n",
    "        resolved_codes = set(status_by_code) | approved_auto_codes | auto_cross_provider_codes\n",
    "        selected = full_review_queue[~full_review_queue.old_aggregator_game_code.isin(resolved_codes)]\n",
    "    elif pass_name == 'cross_provider':\n",
    "        revisit = {'deferred_cross_provider', 'no_match'}\n",
    "        row_status = full_review_queue.old_aggregator_game_code.map(status_by_code).fillna('')\n",
    "        saved_for_follow_up = row_status.isin(revisit)\n",
    "        auto_routed = full_review_queue.old_aggregator_game_code.isin(auto_cross_provider_codes) & row_status.eq('')\n",
    "        selected = full_review_queue[saved_for_follow_up | auto_routed]\n",
    "    else:\n",
    "        raise ValueError(f'Unknown review pass: {pass_name}')\n",
    "    return selected.reset_index(drop=True)\n",
    "\n",
    "\n",
    "def review_one(index=0, top_n=8, all_providers=False):\n",
    "    row = review_queue.iloc[index]\n",
    "    result = inspect(row.old_game_name, row.old_game_provider_name, top_n, all_providers)\n",
    "    print(f'Queue item {index + 1}/{len(review_queue)} · code={row.old_aggregator_game_code}')\n",
    "    return result\n",
    "\n",
    "def record_decision(old_code, titan_product_id='', status='reviewed', note=''):\n",
    "    decisions[old_code] = {'old_aggregator_game_code': old_code, 'titan_product_id': str(titan_product_id), 'status': status, 'note': note}\n",
    "    return save_decisions()\n",
    "\n",
    "def export_decisions(path='iterative_mapping_decisions.csv'):\n",
    "    result = pd.DataFrame(decisions.values())\n",
    "    result.to_csv(ROOT / path, index=False)\n",
    "    return result\n",
    "\n",
    "RULE_STOPWORDS = {'a', 'an', 'and', 'of', 'the', 'to'}\n",
    "\n",
    "def rule_terms(value):\n",
    "    \"\"\"Content terms only: omit known provider-code prefixes and filler words.\"\"\"\n",
    "    raw = tokens(value, expand=False)\n",
    "    if raw and raw[0] in PROVIDER_ALIASES:\n",
    "        raw = raw[1:]\n",
    "    return {term for term in raw if not term.isdigit() and term not in RULE_STOPWORDS}\n",
    "\n",
    "def rule_check(old_name, titan_name):\n",
    "    \"\"\"Suggest only plausible short-form ↔ multi-word abbreviation rules.\"\"\"\n",
    "    old_terms, titan_terms = rule_terms(old_name), rule_terms(titan_name)\n",
    "    old_only = sorted(old_terms - titan_terms)\n",
    "    titan_only = sorted(titan_terms - old_terms)\n",
    "    short_old = [term for term in old_only if 1 < len(term) <= 5]\n",
    "    short_titan = [term for term in titan_only if 1 < len(term) <= 5]\n",
    "    suggestions = []\n",
    "    if len(short_titan) == 1 and len(old_only) >= 2:\n",
    "        suggestions.append(f\"ABBREVIATIONS['{short_titan[0]}'] = '{' '.join(old_only)}'\")\n",
    "    if len(short_old) == 1 and len(titan_only) >= 2:\n",
    "        suggestions.append(f\"ABBREVIATIONS['{short_old[0]}'] = '{' '.join(titan_only)}'\")\n",
    "    return {'old_only': old_only, 'titan_only': titan_only, 'suggestions': suggestions}\n",
    "\n",
    "# Example: record_decision('BP_777_DELUXE_JACKPOT_KING_95', '740323', 'accepted', 'JK=Jackpot King; BP/BL=Blueprint')\n",
    "# export_decisions()"
  ]
}
