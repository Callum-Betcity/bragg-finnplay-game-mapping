    "def search_names(old_name, old_provider_name='', top_n=15, all_providers=False):\n",
    "    pool = titan if all_providers else titan[titan['_provider_key'].eq(provider_key(old_provider_name))]\n",
    "    rows = []\n",
    "    for _, product in pool.iterrows():\n",
    "        s = score_candidate(old_name, product['titan_product_name'], product['titan_friendly_name'])\n",
    "        rows.append({\n",
    "            'titan_product_id': product['titan_product_id'],\n",
    "            'titan_product_name': product['titan_product_name'],\n",
    "            'titan_friendly_name': product['titan_friendly_name'],\n",
    "            'mapped_provider_name': product['mapped_provider_name'],\n",
    "            **s,\n",
    "        })\n",
    "    columns = ['titan_product_id', 'titan_product_name', 'titan_friendly_name', 'mapped_provider_name', 'score', 'match_quality', 'method', 'token_overlap', 'numeric_match', 'family_rule_match']\n",
    "    result = pd.DataFrame(rows, columns=columns)\n",
    "    if result.empty:\n",
    "        return result\n",
    "    return result.sort_values(['match_quality', 'score', 'token_overlap', 'numeric_match'], ascending=False).head(top_n).reset_index(drop=True)\n",
    "\n",
    "def show_name_evidence(old_name, candidate_name):\n",
    "    left, right = set(tokens(old_name, True)), set(tokens(candidate_name, True))\n",
    "    def paint(value):\n",
    "        out = []\n",
    "        for token in tokens(value, True):\n",
    "            colour = '#d9f2d9' if token in left & right else ('#ffe6bf' if token in left else '#cfe8ff')\n",
    "            out.append(f\"<span style='background:{colour}; padding:2px 4px; margin:2px; display:inline-block'>{escape(token)}</span>\")\n",
    "        return ' '.join(out)\n",
    "    return HTML(f\"<div><b>Old:</b> {paint(old_name)}<br><b>Titan:</b> {paint(candidate_name)}</div>\")\n",
    "\n",
    "def inspect(old_name, old_provider_name, top_n=10, all_providers=False):\n",
    "    result = search_names(old_name, old_provider_name, top_n, all_providers)\n",
    "    display(HTML(f\"<h3>{escape(old_name)}</h3><p>Provider: {escape(old_provider_name)} · candidates: {len(result)}</p>\"))\n",
    "    if result.empty and not all_providers:\n",
    "        display(HTML('<p><i>No products for this provider. Try again with <code>all_providers=True</code>.</i></p>'))\n",
    "    else:\n",
    "        display(result)\n",
    "    if len(result):\n",
    "        display(show_name_evidence(old_name, result.iloc[0].titan_friendly_name or result.iloc[0].titan_product_name))\n",
    "    return result\n",
    "\n",
    "example = inspect('BP 777 Deluxe Jackpot King 95', 'Blueprint Gaming', top_n=6)"
  ]
}
