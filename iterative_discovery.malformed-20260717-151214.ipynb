  "source": [
    "import pandas as pd\n",
    "\n",
    "match_keys = [\n",
    "    \"old_aggregator_game_code\",\n",
    "    \"old_game_name\",\n",
    "    \"old_game_provider_name\",\n",
    "]\n",
    "\n",
    "# Normalise key fields so NaN and whitespace do not cause false non-matches\n",
    "for df in (old, existing):\n",
    "    for col in match_keys:\n",
    "        df[col] = df[col].fillna(\"\").str.strip()\n",
    "\n",
    "# Convert the review flag safely if it was read from CSV as text\n",
    "needs_review = (\n",
    "    existing[\"needs_review\"]\n",
    "    .fillna(\"\")\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .str.lower()\n",
    "    .isin([\"true\", \"1\", \"yes\"])\n",
    ")\n",
    "\n",
    "successful_mappings = (\n",
    "    existing.loc[\n",
    "        existing[\"final_titan_product_id\"].notna()\n",
    "        & existing[\"final_titan_product_id\"].astype(str).str.strip().ne(\"\")\n",
    "        & ~needs_review,\n",
    "        match_keys + [\n",
    "            \"final_titan_product_id\",\n",
    "            \"final_mapping_source\",\n",
    "            \"final_mapping_confidence\",\n",
    "        ],\n",
    "    ]\n",
    "    .drop_duplicates(subset=match_keys)\n",
    ")\n",
    "\n",
    "unmapped_old = (\n",
    "    old.merge(\n",
    "        successful_mappings[match_keys].assign(successfully_mapped=True),\n",
    "        on=match_keys,\n",
    "        how=\"left\",\n",
    "        validate=\"many_to_one\",\n",
    "    )\n",
    "    .loc[lambda df: df[\"successfully_mapped\"].isna()]\n",
    "    .drop(columns=\"successfully_mapped\")\n",
    "    .drop_duplicates(subset=match_keys)\n",
    ")\n",
    "\n",
    "print(f\"Distinct old games: {old[match_keys].drop_duplicates().shape[0]:,}\")\n",
    "print(f\"Successfully mapped: {successful_mappings.shape[0]:,}\")\n",
    "print(f\"Still unmapped: {unmapped_old.shape[0]:,}\")"
  ]
}
