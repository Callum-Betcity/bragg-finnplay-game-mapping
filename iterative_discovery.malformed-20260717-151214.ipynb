  "source": [
    "import json\n",
    "import re\n",
    "from pathlib import Path\n",
    "from html import escape\n",
    "\n",
    "import pandas as pd\n",
    "from rapidfuzz import fuzz\n",
    "from IPython.display import HTML, display\n",
    "\n",
    "try:\n",
    "    import ipywidgets as widgets\n",
    "    WIDGETS_AVAILABLE = True\n",
    "except ImportError:\n",
    "    WIDGETS_AVAILABLE = False\n",
    "\n",
    "ROOT = Path.cwd()\n",
    "UNMAPPED_GAMES_CSV = ROOT / 'unmapped_bragg_games.csv'\n",
    "required_columns = {'old_aggregator_game_code', 'old_game_name', 'old_game_provider_name', 'old_bets', 'old_rounds'}\n",
    "review_queue = pd.read_csv(UNMAPPED_GAMES_CSV, dtype=str).fillna('')\n",
    "missing_columns = required_columns - set(review_queue.columns)\n",
    "if missing_columns:\n",
    "    raise ValueError(f'{UNMAPPED_GAMES_CSV.name} is missing columns: {sorted(missing_columns)}')\n",
    "# Compatibility aliases keep the diagnostic cells below focused on this filtered input.\n",
    "old = review_queue.copy()\n",
    "existing = pd.DataFrame(columns=['old_aggregator_game_code', 'old_game_name', 'old_game_provider_name', 'final_titan_product_id', 'final_mapping_source', 'final_mapping_confidence', 'needs_review'])\n",
    "titan = pd.read_csv(ROOT / 'titan_product_mapping_source.csv', dtype=str).fillna('')\n",
    "\n",
    "PROVIDER_ALIASES = {\n",
    "    'bp': 'blueprint', 'bl': 'blueprint', 'blueprint': 'blueprint',\n",
    "    'blueprintgaming': 'blueprint', 'png': 'playngo', 'pg': 'playngo',\n",
    "    'pp': 'pragmaticplay', 'ppn': 'pragmaticplay', 'ppd': 'pragmaticplay',\n",
    "    'evo': 'evolution', 'evold': 'evolution', 'evr': 'evolution',\n",
    "    'mg': 'gamesglobal', 'mgs': 'gamesglobal', 'mgsd': 'gamesglobal',\n",
    "    'gt': 'greentube', 'gtb': 'greentube', 'stk': 'stakelogic',\n",
    "}\n",
    "ABBREVIATIONS = {\n",
    "    'jk': 'jackpot king', 'jpk': 'jackpot king', 'jp': 'jackpot',\n",
    "    'mw': 'megaways', 'megs': 'megaways', 'del': 'deluxe',\n",
    "}\n",
    "AZURE_ORDINALS = {'1': 'a', '2': 'b', '3': 'c', '4': 'd', '5': 'e'}\n",
    "\n",
    "def provider_key(value):\n",
    "    s = re.sub(r'[^a-z0-9]+', '', str(value).lower())\n",
    "    return PROVIDER_ALIASES.get(s, s)\n",
    "\n",
    "def tokens(value, expand=True):\n",
    "    # Split Titan-style CamelCase before lowercasing, e.g. MGSurgeStrikeV94 → MG Surge Strike V 94.\n",
    "    s = str(value).replace('&', ' and ')\n",
    "    s = re.sub(r\"([A-Z])([A-Z][a-z])\", r\"\\1 \\2\", s)\n",
    "    s = re.sub(r\"([a-z0-9])([A-Z])\", r\"\\1 \\2\", s)\n",
    "    s = s.lower()\n",
    "    # Keep compact Titan version suffixes comparable with old names, e.g. Goldv94 → Gold v 94.\n",
    "    s = re.sub(r\"(?<=[a-z])v(?=\\d)\", \" v\", s)\n",
    "    s = re.sub(r\"([a-z])([0-9])\", r\"\\1 \\2\", s)\n",
    "    s = re.sub(r\"([0-9])([a-z])\", r\"\\1 \\2\", s)\n",
    "    s = re.sub(r'[^a-z0-9]+', ' ', s)\n",
    "    raw = s.split()\n",
    "    if not expand:\n",
    "        return raw\n",
    "    result = []\n",
    "    for token in raw:\n",
    "        result.extend(ABBREVIATIONS.get(token, token).split())\n",
    "    return result\n",
    "\n",
    "def compact(value, expand=True):\n",
    "    return ''.join(tokens(value, expand))\n",
    "\n",
    "def number_set(value):\n",
    "    return set(re.findall(r'\\d+', str(value)))\n",
    "\n",
    "def azure_ordinal_match(old_name, product_name, friendly_name):\n",
    "    \"\"\"Match the verified Pragmatic Live Blackjack Azure ordinal family only.\"\"\"\n",
    "    old_terms = set(tokens(old_name, expand=False))\n",
    "    target_terms = set(tokens(product_name, expand=False)) | set(tokens(friendly_name, expand=False))\n",
    "    required_terms = {'live', 'blackjack', 'azure'}\n",
    "    if not required_terms.issubset(old_terms) or not required_terms.issubset(target_terms):\n",
    "        return False\n",
    "    old_ordinal = next((n for n in AZURE_ORDINALS if n in old_terms), None)\n",
    "    return bool(old_ordinal and 'azure' in target_terms and AZURE_ORDINALS[old_ordinal] in target_terms)\n",
    "\n",
    "def score_candidate(old_name, product_name, friendly_name):\n",
    "    old_raw, old_exp = tokens(old_name, False), tokens(old_name, True)\n",
    "    comparisons = []\n",
    "    for label, value in [('product', product_name), ('friendly', friendly_name)]:\n",
    "        for expanded in [False, True]:\n",
    "            target = tokens(value, expanded)\n",
    "            a, b = ' '.join(old_exp if expanded else old_raw), ' '.join(target)\n",
    "            comparisons.append((f'{label}_token_set_' + ('expanded' if expanded else 'literal'), fuzz.token_set_ratio(a, b)))\n",
    "            comparisons.append((f'{label}_partial_' + ('expanded' if expanded else 'literal'), fuzz.partial_ratio(compact(old_name, expanded), compact(value, expanded))))\n",
    "    method, score = max(comparisons, key=lambda x: x[1])\n",
    "    old_exp_set = set(old_exp)\n",
    "    product_terms = set(tokens(product_name, True))\n",
    "    friendly_terms = set(tokens(friendly_name, True))\n",
    "    # Product IDs often retain version/RTP while friendly names retain better word boundaries.\n",
    "    # Their union is therefore the most complete representation of one Titan candidate.\n",
    "    combined_terms = product_terms | friendly_terms\n",
    "    overlap = len(old_exp_set & combined_terms) / max(1, len(old_exp_set))\n",
    "    numeric_match = bool(number_set(old_name) & (number_set(product_name) | number_set(friendly_name)))\n",
    "    token_overlap = round(overlap * 100, 2)\n",
    "    # token_set_ratio can score a short subset as 100; coverage prevents it outranking a fuller match.\n",
    "    match_quality = round(0.4 * score + 0.6 * token_overlap, 2)\n",
    "    family_rule_match = azure_ordinal_match(old_name, product_name, friendly_name)\n",
    "    if family_rule_match:\n",
    "        match_quality = max(match_quality, 99.0)\n",
    "    return {'score': round(score, 2), 'match_quality': match_quality, 'method': method, 'token_overlap': token_overlap, 'numeric_match': numeric_match, 'family_rule_match': family_rule_match}\n",
    "\n",
    "titan['_provider_key'] = titan['mapped_provider_name'].map(provider_key)\n",
    "review_queue['_provider_key'] = review_queue['old_game_provider_name'].map(provider_key)\n",
    "for column in ['old_bets', 'old_wins', 'old_rounds']:\n",
    "    if column in review_queue:\n",
    "        review_queue[column] = pd.to_numeric(review_queue[column], errors='coerce').fillna(0)\n",
    "review_queue = (\n",
    "    review_queue\n",
    "    .drop_duplicates(subset=['old_aggregator_game_code', 'old_game_name', 'old_game_provider_name'])\n",
    "    .sort_values(['old_bets', 'old_rounds'], ascending=[False, False])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "print(f'Loaded {len(review_queue):,} unmapped games and {len(titan):,} Titan products.')"
  ]
}
