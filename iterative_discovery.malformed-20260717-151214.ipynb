    "if WIDGETS_AVAILABLE:\n",
    "    review_pass = widgets.ToggleButtons(\n",
    "        options=[('Same-provider priority', 'primary'), ('Cross-provider follow-up', 'cross_provider')],\n",
    "        value='primary',\n",
    "        description='Pass',\n",
    "    )\n",
    "    review_queue = queue_for_pass(review_pass.value)\n",
    "    bookmark_index = 0\n",
    "    if BOOKMARK_JSON.exists():\n",
    "        try:\n",
    "            bookmark_index = int(json.loads(BOOKMARK_JSON.read_text()).get('queue_index', 0))\n",
    "        except (ValueError, json.JSONDecodeError):\n",
    "            pass\n",
    "    state = {'index': max(0, min(bookmark_index, len(review_queue) - 1)), 'candidates': pd.DataFrame(), 'dismissed': set()}\n",
    "    candidate_cache = {}\n",
    "    find_box = widgets.Text(placeholder='Game code, title, or provider', description='Find')\n",
    "    jump_box = widgets.BoundedIntText(value=1, min=1, max=len(review_queue), description='Item')\n",
    "    all_providers = widgets.Checkbox(value=False, description='All providers')\n",
    "    previous = widgets.Button(description='← Previous')\n",
    "    next_item = widgets.Button(description='Next →', button_style='primary')\n",
    "    candidate_picker = widgets.Dropdown(description='Candidate', layout=widgets.Layout(width='95%'))\n",
    "    accept = widgets.Button(description='Accept match', button_style='success')\n",
    "    dismiss = widgets.Button(description='Reject candidate')\n",
    "    defer = widgets.Button(description='Defer to cross-provider')\n",
    "    no_match = widgets.Button(description='Confirm no match')\n",
    "    note = widgets.Textarea(placeholder='Why this is correct / uncertain', description='Note', layout=widgets.Layout(width='95%', height='70px'))\n",
    "    status = widgets.HTML()\n",
    "    output = widgets.Output()\n",
    "\n",
    "    def save_bookmark():\n",
    "        BOOKMARK_JSON.write_text(json.dumps({'queue_index': state['index']}, indent=2))\n",
    "\n",
    "    def is_eligible(code):\n",
    "        status = decisions.get(code, {}).get('status', '')\n",
    "        if review_pass.value == 'primary':\n",
    "            return not status\n",
    "        return status in {'deferred_cross_provider', 'no_match'} or (not status and code in auto_cross_provider_codes)\n",
    "\n",
    "    def active_index(start, direction=1):\n",
    "        for offset in range(len(review_queue)):\n",
    "            index = (start + direction * offset) % len(review_queue)\n",
    "            code = review_queue.iloc[index].old_aggregator_game_code\n",
    "            if is_eligible(code):\n",
    "                return index\n",
    "        return start\n",
    "\n",
    "    def candidate_results(index):\n",
    "        search_all_providers = all_providers.value or review_pass.value == 'cross_provider'\n",
    "        key = (index, search_all_providers)\n",
    "        if key not in candidate_cache:\n",
    "            row = review_queue.iloc[index]\n",
    "            candidate_cache[key] = search_names(row.old_game_name, row.old_game_provider_name, top_n=10, all_providers=search_all_providers)\n",
    "        result = candidate_cache[key].copy()\n",
    "        code = review_queue.iloc[index].old_aggregator_game_code\n",
    "        return result[~result.titan_product_id.isin({product for old_code, product in state['dismissed'] if old_code == code})]\n",
    "\n",
    "    def selected_candidate():\n",
    "        if state['candidates'].empty or candidate_picker.value is None:\n",
    "            return None\n",
    "        return state['candidates'].loc[state['candidates'].titan_product_id.eq(str(candidate_picker.value))].iloc[0]\n",
    "\n",
    "    def render(change=None):\n",
    "        state['index'] = active_index(max(0, min(state['index'], len(review_queue) - 1)))\n",
    "        row = review_queue.iloc[state['index']]\n",
    "        jump_box.value = state['index'] + 1\n",
    "        state['candidates'] = candidate_results(state['index'])\n",
    "        options = [(f\"{r.titan_product_id} · {r.titan_friendly_name or r.titan_product_name} · quality {r.match_quality:.1f} (raw {r.score:.1f}, coverage {r.token_overlap:.0f}%){' · Azure ordinal rule' if r.family_rule_match else ''}\", r.titan_product_id) for _, r in state['candidates'].iterrows()]\n",
    "        candidate_picker.options = options\n",
    "        candidate_picker.value = options[0][1] if options else None\n",
    "        pass_label = 'Cross-provider follow-up' if review_pass.value == 'cross_provider' else 'Same-provider priority'\n",
    "        status.value = f\"<b>{state['index'] + 1:,}/{len(review_queue):,}</b> · €{row.old_bets:,.2f} bets · {escape(row.old_game_provider_name)} · <code>{escape(row.old_aggregator_game_code)}</code> · {len(decisions):,} saved · {pass_label}\"\n",
    "        save_bookmark()\n",
    "        with output:\n",
    "            output.clear_output(wait=True)\n",
    "            display(HTML(f\"<h3>{escape(row.old_game_name)}</h3>\"))\n",
    "            if state['candidates'].empty:\n",
    "                message = 'No candidates across Titan; confirm no match if this is expected.' if review_pass.value == 'cross_provider' or all_providers.value else 'No same-provider candidates. Defer this for the cross-provider pass.'\n",
    "                display(HTML(f'<i>{message}</i>'))\n",
    "            else:\n",
    "                display(state['candidates'])\n",
    "                show_selected()\n",
    "\n",
    "    def show_selected(change=None):\n",
    "        candidate = selected_candidate()\n",
    "        if candidate is None:\n",
    "            return\n",
    "        row = review_queue.iloc[state['index']]\n",
    "        target_name = candidate.titan_friendly_name or candidate.titan_product_name\n",
    "        check = rule_check(row.old_game_name, target_name)\n",
    "        with output:\n",
    "            display(show_name_evidence(row.old_game_name, target_name))\n",
    "            display(HTML(f\"<p><b>Rule check (literal terms):</b> old-only={escape(', '.join(check['old_only']) or '—')} · Titan-only={escape(', '.join(check['titan_only']) or '—')}</p>\"))\n",
    "            if check['suggestions']:\n",
    "                display(HTML('<p><b>Test before adding globally:</b><br><code>' + '<br>'.join(escape(s) for s in check['suggestions']) + '</code></p>'))\n",
    "\n",
    "    def move(delta):\n",
    "        state['index'] = active_index(state['index'] + delta, 1 if delta >= 0 else -1)\n",
    "        note.value = ''\n",
    "        render()\n",
    "\n",
    "    def on_find(_):\n",
    "        query = find_box.value.strip().lower()\n",
    "        if not query:\n",
    "            return\n",
    "        mask = review_queue[['old_aggregator_game_code', 'old_game_name', 'old_game_provider_name']].astype(str).apply(lambda column: column.str.lower().str.contains(query, regex=False)).any(axis=1)\n",
    "        if mask.any():\n",
    "            state['index'] = review_queue.index[mask][0]\n",
    "            render()\n",
    "        else:\n",
    "            status.value = f'<b>No queue match for:</b> {escape(find_box.value)}'\n",
    "\n",
    "    def on_accept(_):\n",
    "        candidate = selected_candidate()\n",
    "        if candidate is None:\n",
    "            return\n",
    "        row = review_queue.iloc[state['index']]\n",
    "        record_decision(row.old_aggregator_game_code, candidate.titan_product_id, 'accepted', note.value)\n",
    "        move(1)\n",
    "\n",
    "    def on_dismiss(_):\n",
    "        candidate = selected_candidate()\n",
    "        if candidate is not None:\n",
    "            state['dismissed'].add((review_queue.iloc[state['index']].old_aggregator_game_code, str(candidate.titan_product_id)))\n",
    "            render()\n",
    "\n",
    "    def on_defer(_):\n",
    "        row = review_queue.iloc[state['index']]\n",
    "        record_decision(row.old_aggregator_game_code, '', 'deferred_cross_provider', note.value)\n",
    "        move(1)\n",
    "\n",
    "    def on_no_match(_):\n",
    "        row = review_queue.iloc[state['index']]\n",
    "        record_decision(row.old_aggregator_game_code, '', 'confirmed_no_match', note.value)\n",
    "        move(1)\n",
    "\n",
    "    def on_pass_change(change):\n",
    "        global review_queue\n",
    "        review_queue = queue_for_pass(change['new'])\n",
    "        candidate_cache.clear()\n",
    "        state['index'] = 0\n",
    "        jump_box.max = max(1, len(review_queue))\n",
    "        all_providers.disabled = change['new'] == 'cross_provider'\n",
    "        defer.disabled = change['new'] == 'cross_provider'\n",
    "        if change['new'] == 'cross_provider':\n",
    "            all_providers.value = True\n",
    "        render()\n",
    "\n",
    "    previous.on_click(lambda _: move(-1))\n",
    "    next_item.on_click(lambda _: move(1))\n",
    "    accept.on_click(on_accept)\n",
    "    dismiss.on_click(on_dismiss)\n",
    "    defer.on_click(on_defer)\n",
    "    no_match.on_click(on_no_match)\n",
    "    find_box.on_submit(on_find)\n",
    "    jump_box.observe(lambda change: (state.update(index=change['new'] - 1), render()) if change['name'] == 'value' else None, names='value')\n",
    "    all_providers.observe(render, names='value')\n",
    "    review_pass.observe(on_pass_change, names='value')\n",
    "    candidate_picker.observe(show_selected, names='value')\n",
    "    controls = widgets.VBox([\n",
    "        widgets.HBox([review_pass, find_box, jump_box, all_providers]),\n",
    "        widgets.HBox([previous, next_item, accept, dismiss, defer, no_match]),\n",
    "        candidate_picker, note, status, output,\n",
    "    ])\n",
    "    display(controls)\n",
    "    render()\n",
    "else:\n",
    "    print('Install ipywidgets for the review workbench; search_names and record_decision remain available.')"
  ]
}
